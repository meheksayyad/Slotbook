{
  "info": {
    "name": "SlotBook API",
    "description": "Run `make seed` first. Folders are meant to be run top-to-bottom.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "access",
      "value": ""
    },
    {
      "key": "court_id",
      "value": ""
    },
    {
      "key": "booking_id",
      "value": ""
    },
    {
      "key": "order_id",
      "value": ""
    },
    {
      "key": "amount_minor",
      "value": ""
    },
    {
      "key": "start_time",
      "value": ""
    },
    {
      "key": "end_time",
      "value": ""
    },
    {
      "key": "webhook_secret",
      "value": "dev-webhook-secret"
    },
    {
      "key": "webhook_body",
      "value": ""
    },
    {
      "key": "webhook_signature",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"player@example.com\",\n  \"password\": \"S3cure-pass!word\",\n  \"first_name\": \"Pat\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": []
        },
        {
          "name": "Login (customer)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/token/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "token"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@slotbook.test\",\n  \"password\": \"Passw0rd!123\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"access\", pm.response.json().access);"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/me/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "me"
              ],
              "query": []
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": []
        }
      ]
    },
    {
      "name": "2. Catalog",
      "item": [
        {
          "name": "List venues",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/venues/?city=Mumbai",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "venues"
              ],
              "query": [
                {
                  "key": "city",
                  "value": "Mumbai"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": []
        },
        {
          "name": "List courts (stores court_id)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/courts/?sport=football",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "courts"
              ],
              "query": [
                {
                  "key": "sport",
                  "value": "football"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"court_id\", pm.response.json().results[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Availability",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/courts/{{court_id}}/availability/?date=2030-01-01",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "courts",
                "{{court_id}}",
                "availability"
              ],
              "query": [
                {
                  "key": "date",
                  "value": "2030-01-01"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": []
        },
        {
          "name": "Quote",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/courts/{{court_id}}/quote/?start_time={{start_time}}&end_time={{end_time}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "courts",
                "{{court_id}}",
                "quote"
              ],
              "query": [
                {
                  "key": "start_time",
                  "value": "{{start_time}}"
                },
                {
                  "key": "end_time",
                  "value": "{{end_time}}"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = new Date(); d.setUTCDate(d.getUTCDate() + 2); d.setUTCHours(12, 30, 0, 0);   // 18:00 IST",
                  "const e = new Date(d.getTime() + 3600 * 1000);",
                  "pm.collectionVariables.set(\"start_time\", d.toISOString());",
                  "pm.collectionVariables.set(\"end_time\", e.toISOString());"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Booking flow",
      "item": [
        {
          "name": "Create booking (409 if run twice)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/bookings/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "bookings"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\"court\": {{court_id}}, \"start_time\": \"{{start_time}}\", \"end_time\": \"{{end_time}}\"}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = new Date(); d.setUTCDate(d.getUTCDate() + 2); d.setUTCHours(12, 30, 0, 0);   // 18:00 IST",
                  "const e = new Date(d.getTime() + 3600 * 1000);",
                  "pm.collectionVariables.set(\"start_time\", d.toISOString());",
                  "pm.collectionVariables.set(\"end_time\", e.toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"booking_id\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Pay (creates order)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/bookings/{{booking_id}}/pay/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "bookings",
                "{{booking_id}}",
                "pay"
              ],
              "query": []
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set(\"order_id\", j.provider_order_id);",
                  "pm.collectionVariables.set(\"amount_minor\", Math.round(parseFloat(j.amount) * 100));"
                ]
              }
            }
          ]
        },
        {
          "name": "Gateway webhook (signed, simulates payment)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Webhook-Signature",
                "value": "{{webhook_signature}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/payments/webhook/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "payments",
                "webhook"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{{webhook_body}}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = JSON.stringify({event: \"payment.captured\", payload: {payment: {entity: {",
                  "  id: \"pay_postman\", order_id: pm.collectionVariables.get(\"order_id\"),",
                  "  amount: parseInt(pm.collectionVariables.get(\"amount_minor\"))}}}});",
                  "pm.collectionVariables.set(\"webhook_body\", body);",
                  "pm.collectionVariables.set(\"webhook_signature\",",
                  "  CryptoJS.HmacSHA256(body, pm.collectionVariables.get(\"webhook_secret\")).toString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"confirmed\", () => pm.expect(pm.response.json().status).to.be.oneOf([\"confirmed\",\"duplicate\"]));"
                ]
              }
            }
          ]
        },
        {
          "name": "My bookings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/bookings/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "bookings"
              ],
              "query": []
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": []
        },
        {
          "name": "Cancel booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/bookings/{{booking_id}}/cancel/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "bookings",
                "{{booking_id}}",
                "cancel"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Rain forecast\"\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": []
        },
        {
          "name": "My payments",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/payments/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "payments"
              ],
              "query": []
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": []
        }
      ]
    },
    {
      "name": "4. Owner analytics",
      "item": [
        {
          "name": "Login (owner)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/token/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "token"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"owner@slotbook.test\",\n  \"password\": \"Passw0rd!123\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"access\", pm.response.json().access);"
                ]
              }
            }
          ]
        },
        {
          "name": "Summary",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/analytics/summary/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "analytics",
                "summary"
              ],
              "query": []
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": []
        },
        {
          "name": "Revenue by day",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/analytics/revenue-by-day/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "analytics",
                "revenue-by-day"
              ],
              "query": []
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": []
        },
        {
          "name": "Top courts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/analytics/top-courts/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "analytics",
                "top-courts"
              ],
              "query": []
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": []
        }
      ]
    }
  ]
}