# --- Django ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# --- Postgres (required: booking integrity uses a Postgres exclusion constraint) ---
POSTGRES_DB=slotbook
POSTGRES_USER=slotbook
POSTGRES_PASSWORD=slotbook
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0
# --- Payments: mock | razorpay ---
PAYMENT_GATEWAY=mock
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=SlotBook <no-reply@slotbook.example>
